# WebDAV URL of your files, ending in /remote.php/dav/files/<username>/
NC_URL=https://cloud.example.com/remote.php/dav/files/alice/
NC_USER=alice
# Use an app password: Personal settings > Security > Devices & sessions
NC_PASS=
# Secret from Administration settings > Additional settings > Video Thumbnail Relay
NC_SECRET=
NC_STRICT_TLS=true

# Days to skip rescanning an unchanged folder
SCAN_INTERVAL_DAYS=7

# Local paths
TEMP_DIR=./tmp_thumbs
FOLDER_CACHE=./folder_cache.csv
THUMB_CACHE=./thumb_cache.csv
FAIL_CACHE=./fail_cache.csv

# Performance (FFMPEG_THREADS empty = CPU cores - 1)
FFMPEG_THREADS=
IO_CONCURRENCY=2
MAX_VIDEO_SIZE_MB=3000
